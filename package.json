{
  "name": "k-on-practice-desktop",
  "productName": "K-on practice",
  "version": "1.1.0",
  "description": "K-on practice のパソコン用アプリ（Songsterr を右側に埋め込んで表示）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "author": "K-on practice",
  "build": {
    "appId": "app.k-on-practice.desktop",
    "productName": "K-on practice",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "app-preload.js",
      "panel-preload.js",
      "panel.html",
      "icon.ico",
      "icon.png",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis",
      "artifactName": "K-on-practice-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "K-on practice",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "K-on practice",
        "schemes": [
          "kon-practice"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Bistral223",
        "repo": "k-on-practice-desktop"
      }
    ],
    "mac": {
      "icon": "icon-mac.png",
      "category": "public.app-category.music",
      "target": "dmg",
      "artifactName": "K-on-practice-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "K-on practice",
      "artifactName": "K-on-practice-mac.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
